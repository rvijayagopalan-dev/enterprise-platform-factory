{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.enterprise-platform-factory.dev/product/components/capability-relationship.schema.json",
  "title": "EPF Capability Graph Edge",
  "type": "object",
  "required": [
    "id",
    "sourceId",
    "sourceType",
    "predicate",
    "targetId",
    "targetType",
    "lifecycleState",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "type": "string"
    },
    "predicate": {
      "enum": [
        "parentOf",
        "childOf",
        "specializes",
        "extends",
        "dependsOn",
        "enables",
        "supports",
        "overlapsWith",
        "complements",
        "supersedes",
        "mapsTo",
        "realizedBy",
        "partiallyRealizedBy",
        "ownedBy",
        "stewardedBy",
        "measuredBy",
        "governedBy",
        "consumes",
        "produces"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "targetType": {
      "type": "string"
    },
    "directionality": {
      "enum": [
        "directed",
        "symmetric"
      ],
      "default": "directed"
    },
    "mappingKind": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "maxLength": 4000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceSystem",
        "actorType"
      ],
      "properties": {
        "sourceSystem": {
          "type": "string"
        },
        "actorType": {
          "enum": [
            "human",
            "agent",
            "workload",
            "service",
            "external"
          ]
        },
        "actorId": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycleState": {
      "enum": [
        "proposed",
        "in_review",
        "accepted",
        "rejected",
        "deprecated"
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validTo": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}